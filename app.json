{
  "expo": {
    "name": "UCLL Mobile Starter",
    "slug": "ucll-mobile-starter",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ucllstarter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Pootmaat",
      "shortName": "Pootmaat",
      "themeColor": "#28543d",
      "backgroundColor": "#f8f8f3",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
